# ==========================================
# OneClick Automics CRM — Environment Variables
# Placeholder values only — Never commit real secrets!
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Client Configuration
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME="OneClick Automics CRM"

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/oneclick_crm
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=3

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_EXPIRES_IN=24h
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15
SESSION_SECRET=replace_with_a_secure_session_secret

# Multi-Tenant & Default Settings
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN

# Integration Placeholders (Do not use production credentials)
WHATSAPP_GRAPH_API_VERSION=v26.0
# The server constructs Meta Graph API endpoints from this version.
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
WHATSAPP_ACCESS_TOKEN=placeholder_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_webhook_verify_token
WHATSAPP_APP_SECRET=placeholder_app_secret

WEBSITE_LEAD_WEBHOOK_SECRET=placeholder_website_webhook_secret

# Billing webhook verification. Keep secrets server-side; never put these in client env.
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_endpoint_secret
# MOCK_BILLING_WEBHOOK_SECRET=replace_with_a_random_secret_for_non-test_local_use
# Razorpay webhook support is not implemented; do not configure it yet.

# Public demo defaults. These are public demo credentials, not administrator credentials.
PUBLIC_DEMO_ENABLED=true
PUBLIC_DEMO_PASSWORD=demo123
