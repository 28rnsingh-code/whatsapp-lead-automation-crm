# ==========================================
# OneClick Automics CRM — Environment Variables
# Placeholder values only — Never commit real secrets!
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Client Configuration
VITE_API_BASE_URL=/api
VITE_APP_NAME="OneClick Automics CRM"

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Required for database-backed admin bootstrap; never commit real values
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace Admin

# Production CORS allowlist: exact Vercel origin(s), comma separated
CORS_ORIGINS=https://YOUR-APP.vercel.app

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=replace_with_32_random_chars_or_64_hex_chars
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15
SESSION_SECRET=replace_with_a_secure_session_secret

# Multi-Tenant & Default Settings
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN

# Integration Placeholders (Do not use production credentials)
WHATSAPP_API_ENDPOINT=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

WEBSITE_LEAD_WEBHOOK_SECRET=

# Password reset email delivery uses Resend; leave blank until credentials are issued.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
EMAIL_FROM=
APP_PUBLIC_URL=http://localhost:5173

# Workspace bootstrap settings; set them before running the seed command.
WORKSPACE_NAME=
WORKSPACE_SLUG=
