# Server Port and Environment
PORT=4000
NODE_ENV=production

# Database Configuration (Multi-tenant PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/oneclick_crm

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=your_cryptographically_secure_jwt_secret_min_32_chars

# AES-256-GCM Encryption Key for Storing Tenant Secrets (WhatsApp tokens, AI API keys) at rest
# (32-character string or 64-character hex string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Default Locale & Currency for Tenancy
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Dedicated Test Database (Automated tests refuse to run against 'oneclick_crm' to prevent pollution)
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/oneclick_crm_test

# Public website demo. The shared credentials are intentionally displayed on the demo login.
# Override PUBLIC_DEMO_PASSWORD if the public password is changed in the UI/documentation.
PUBLIC_DEMO_ENABLED=true
PUBLIC_DEMO_PASSWORD=demo123

# Required in production only when bootstrapping a new default Admin account.
# Use a unique secret of at least 16 characters; never commit the real value.
# BOOTSTRAP_ADMIN_PASSWORD=

# Billing webhooks. Stripe is the only implemented real billing webhook adapter.
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_endpoint_secret
# MOCK_BILLING_WEBHOOK_SECRET=replace_with_a_random_secret_for_non-test_local_use
# Razorpay is currently unsupported; mock billing callbacks are blocked in production.
