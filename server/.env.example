# Server Port and Environment
PORT=4000
NODE_ENV=production

# Database Configuration (Multi-tenant PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/oneclick_crm

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=your_cryptographically_secure_jwt_secret_min_32_chars

# AES-256-GCM Encryption Key for Storing Tenant Secrets (WhatsApp tokens, AI API keys) at rest
# (32-character string or 64-character hex string)
ENCRYPTION_KEY=replace_with_a_unique_secure_random_64_char_encryption_key

# Default Locale & Currency for Tenancy
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Dedicated Test Database (Automated tests refuse to run against 'oneclick_crm' to prevent pollution)
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/oneclick_crm_test
